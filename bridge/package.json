{
  "name": "@figma-exporter/bridge",
  "version": "0.0.0",
  "private": true,
  "description": "Local WebSocket bridge between the Figma plugin and Node tooling, plus the tokens:sync CLI",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "tokens:sync": "tsx src/cli.ts",
    "bundle": "node scripts/build-bundle.mjs"
  },
  "dependencies": {
    "@figma-exporter/codegen-tokens": "*",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "esbuild": "^0.28.2"
  }
}
